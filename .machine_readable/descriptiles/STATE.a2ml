[metadata]
project = "universal-modding-studio"
version = "0.1.0-alpha"
type = "modding-studio"
last-updated = "2026-08-29"
branch = "main"
build-status = "single-repository profile lanes implemented; remote rename cutover in progress"
test-status = "115 Rust/Crusoe workspace tests, Clippy, generation drift, Slavia validation, architecture boundaries, 24 Zig FFI tests, 17 Idris2 modules, 40 extractor checks and the repaired IDApTIK v3 round trip green locally"

[project-context]
description = "Universal Modding Studio: independent authoring, generation, validation and packaging platform."
desired-repository = "metadatastician/universal-modding-studio"
first-profile = "idaptik"
second-profile = "chronicles-of-slavia"

[component-status]
profile-sdk = { status = "tested", notes = "Versioned reflection, registration and isolation. Complementary to ums-profiles, not superseded by it (ADR-0015)." }
profile-compiler = { status = "tested", notes = "ums-profiles consumes IDApTIK contracts/idaptik/v1 by path and emits the exact package the real game loader accepts. Merged from idaptik-ums-canonical branch agent/idaptik-roundtrip." }
idaptik-profile = { status = "tested-compatibility", notes = "Generated reflection and executable edit facade; model/edit mismatch remains." }
slavia-profile = { status = "reflection-only", notes = "Bounded Zone A fixture validated through the generic profile protocol; no loader, compiler or runtime adapter." }
manifest-v2 = { status = "tested", notes = "Capabilities plus legacy compatibility and migration." }
enaction-adapter = { status = "designed", notes = "Trait and schema seam only." }
studio-ui = { status = "aspirational", notes = "Specified multi-lens target; no frontend." }
dependency-boundaries = { status = "tested", notes = "scripts/check-architecture-boundaries.sh rejects reverse runtime/UI dependencies and cross-game profile imports; hard-fails on a missing sibling." }
end-to-end-roundtrip = { status = "gated", notes = "Observed green in CI 2026-07-27 (run 30288163489). ADR-0014 deterministic-repeat-output clause now met: the gate compiles twice and requires byte-identical artifacts. Remaining clause: no comparison of the loader exported canonical model against authored state, which is blocked on IDApTIK package-runner exporting LevelData." }
idris2-abi = { status = "machine-checked-scope", notes = "17 modules typecheck; Validation deciders construct encoded witnesses. Raw extraction and Zig implementation parity remain open, so ABI scaffolding is not an end-to-end proof." }
zig-ffi = { status = "tested-noncompliant", notes = "Integration tests exist, but std.fs/std.io violate the unified-hexadeca purity gate and generated-header ownership is incomplete." }
snif-boundary = { status = "not-applicable", notes = "No BEAM runtime in UMS. Future BEAM native compute must use SNIFs; raw NIFs are forbidden." }

[route-to-mvp]
remaining = [
  { item = "Unify the public profile surface: expose the ums-profiles compiler through ums-profile-sdk's packageCompiler capability so there is one public abstraction, not two. Both crates stay; the second public surface does not (ADR-0015)", priority = "critical" },
  { item = "Advance the round trip from gated to tested: have IDApTIK package-runner export the canonical LevelData the loader built, then compare it field by field against authored UMS state. Artifact determinism is now asserted; this is the last ADR-0014 clause outstanding", priority = "critical" },
  { item = "Wire the raw extraction path through ValidatedLevel and prove parity between the Idris2-owned ABI and Zig implementation; deciders exist but extraction remains unproved", priority = "high" },
  { item = "Remove std.fs/std.io from the Zig FFI through the unified hexadeca API and generate the C header from the Idris2 ABI", priority = "high" },
  { item = "Complete the universal-modding-studio rename and archive canonical-ums read-only with ADR-0018's disposition appendix", priority = "high" },
  { item = "Close IDApTIK modelled-versus-editable gaps", priority = "high" },
  { item = "Keep Slavia reflection aligned with its authoritative repository", priority = "medium" },
  { item = "Implement interactive studio only after host-neutral selection/IR seams exist", priority = "medium" }
]

[cross-repository-reconciliation]
coordination-id = "ums-idaptik-slavia-enaction-2026-07-25"
decision-status = "one-repository profile-lane model accepted in ADR-0018; rename/archive cutover in progress"
role = "Authoring, profile reflection, validation orchestration, game-specific compilation, and package emission; never game-runtime truth."
settled = [
  "Released games must not depend on the UMS user interface",
  "UMS Core must not depend on IDApTIK or Chronicles of Slavia runtime crates",
  "Game profiles consume game-owned versioned contracts",
  "IDApTIK and Slavia vocabulary must remain isolated from one another and from UMS Core",
]
roundtrip-proof-branch = "agent/idaptik-roundtrip"
roundtrip-proof-commit = "657e4f3682ec74643f14bd335c436446be99cc26"
roundtrip-proof-status = "Merged 2026-07-27 into this repository by cherry-pick with history (ADR-0015). idaptik-ums-canonical is superseded and awaits archival."
profile-architecture-branch = "origin/agent/universal-modding-studio"
profile-architecture-head = "4b302842940d37e37f445949306f71487b4424dd"
profile-architecture-status = "Six branch commits, five origin/main commits behind, no pull request or recorded branch CI."
reconciliation-decision = "Use ums-profile-sdk as the public profile abstraction and migrate the working exact IDApTIK compiler, same-artifact loader gate, dependency checks, and Slavia semantic fixture into it."
contract-authority = "metadatastician/IDApTIK contracts/idaptik/v1; legacy UMS Nickel registries may be migration or authoring inputs but are not final game authority."
canonical-profile-layout = [
  "profiles/idaptik/v1",
  "profiles/slavia/v1",
]
preserve-from-profile-architecture = [
  "typed ProfileDescriptor and capability model",
  "explicit evidence levels",
  "profile vocabulary isolation",
  "optional Enaction adapter boundary",
]
preserve-from-roundtrip-proof = [
  "real IDApTIK contract consumption",
  "one reproducibly emitted package artifact",
  "acceptance by the actual IDApTIK loader",
  "deterministic execution, snapshot, restore, and replay comparison",
  "bounded Zone A / Border Path semantic coverage",
]
required-order = [
  "DONE 2026-07-27: cherry-picked ums-profiles, the roundtrip and slavia-profile-check recipes, and the boundary script into this repository",
  "DONE 2026-07-27: consolidated both IDApTIK and both Slavia profile layouts under profiles/<game>/v<N>/",
  "DONE 2026-07-27: reran roundtrip-idaptik, slavia-profile-check, architecture-check, gen-check, config-check, dlc-check, ai-edit-check, workspace tests and Clippy -- all pass",
  "OPEN: expose the ums-profiles compiler through ums-profile-sdk so one public abstraction is published, not two",
  "IN PROGRESS 2026-08-29: rename this repository in place to universal-modding-studio and archive canonical-ums with ADR-0018's disposition appendix",
]
do-not = [
  "Do not merge both profile SDKs unchanged",
  "Do not make legacy UMS declarations authoritative over the game-owned contract",
  "Do not claim the broad profile-architecture branch already proves a real game-loader round trip",
]
